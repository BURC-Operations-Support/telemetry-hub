# ------------------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
Testing/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe

# ------------------------------------------------------------
